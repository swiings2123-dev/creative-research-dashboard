OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# Required for TikTok (manual search's TikTok source, and both Product
# Finder modes). From Apify Console -> Settings -> API & Integrations ->
# Personal API token.
APIFY_TOKEN=

# Only needed when deploying the worker publicly (see DEPLOY.md). Leave unset
# for local use - the app is fully open with no secret required.
APP_SHARED_SECRET=
# Restrict CORS to your deployed frontend's origin once you have it; "*" (the
# default) means literally any website can call this worker's API.
ALLOWED_ORIGIN=*
