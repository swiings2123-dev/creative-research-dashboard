OPENAI_API_KEY=sk-...
# Used by openai_angles.py's "Generate AI angles" feature only - keep this
# on a model that accepts a custom temperature (that feature passes 0.9).
OPENAI_MODEL=gpt-4o
# The actual product-photo-vs-ad-video same-product check in
# product_intel.py's _images_match - pinned to gpt-6-astra, the current
# flagship vision-capable model (confirmed live 2026-09-05). That
# function's OpenAI client uses the us.api.openai.com regional endpoint
# this model requires. NOTE: product_intel.py's image_to_keyword/
# synthesize_query deliberately do NOT use this env var - they're
# hardcoded to gpt-4o, since gpt-6-astra only accepts its default
# temperature (no override), which made those two steps generate a
# different search phrase almost every call and broke result consistency.
OPENAI_VISION_MODEL=gpt-6-astra

# Required for TikTok (manual search's TikTok source, and both Product
# Finder modes). From Apify Console -> Settings -> API & Integrations ->
# Personal API token.
APIFY_TOKEN=

# Only needed when deploying the worker publicly (see DEPLOY.md). Leave unset
# for local use - the app is fully open with no secret required.
APP_SHARED_SECRET=
# Restrict CORS to your deployed frontend's origin once you have it; "*" (the
# default) means literally any website can call this worker's API.
ALLOWED_ORIGIN=*
