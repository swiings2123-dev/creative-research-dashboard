# Server
PORT=3001
NODE_ENV=development

# Apify
APIFY_API_TOKEN=your_apify_api_token_here

# Google Gemini Vision API
GEMINI_API_KEY=your_gemini_api_key_here
# Comma-separated fallback chain (next model is used when one hits its daily free-tier quota)
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.1-flash-lite-preview,gemini-3-flash-preview

# Optional: TikTok toggle
ENABLE_TIKTOK=false

# Deployed frontend URL(s) allowed to call this API, comma-separated (only when frontend is hosted separately)
# FRONTEND_URL=https://reelscope.vercel.app
